# ─────────────────────────────────────────────────────────────
# AMATES SOLUTIONS — environment template
# Copy to `.env`. NEVER commit `.env`. No key here is ever exposed
# to the browser: nothing is prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Neon Postgres (Neon dashboard → Connection string → Pooled)
# e.g. postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/amates?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# OpenRouter — BACKEND ONLY. Used by src/lib/openrouter.ts
#
# OPTIONAL. The key can also be entered in the backoffice at
# /admin/settings, where it is stored in Postgres encrypted with
# AES-256-GCM (key derived from ADMIN_SESSION_SECRET).
#
# Precedence: this env var wins. Leave it blank to use the key stored
# through the admin UI — that is the intended build-phase workflow.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://amatessolutions.com
OPENROUTER_SITE_NAME=Amates Solutions

# Admin backoffice passkey (build phase — see README "Security notes")
ADMIN_PASSKEY=5309
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Machine-to-machine access for POST /api/quote/generate (header: x-api-key)
AGENT_API_KEY=

# WhatsApp Cloud API webhook verification token
WHATSAPP_VERIFY_TOKEN=amates-verify

# Optional: field crew dispatch hook fired from the booking calendar
CREW_DISPATCH_WEBHOOK_URL=

# Bearer token for POST /api/cron/sweep (Vercel Cron sends this automatically)
CRON_SECRET=
