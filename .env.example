# ─────────────────────────────────────────────────────────────
# AMATES SOLUTIONS — environment template
# Copy to `.env`. NEVER commit `.env`. No key here is ever exposed
# to the browser: nothing is prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Neon Postgres (Neon dashboard → Connection string → Pooled)
# e.g. postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/amates?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Same database, direct (non-pooled) host. Required by drizzle-kit migrations,
# which cannot run through the pooler.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# OpenRouter — BACKEND ONLY. Used by src/lib/openrouter.ts
#
# OPTIONAL. The key can also be entered in the backoffice at
# /admin/settings, where it is stored in Postgres encrypted with
# AES-256-GCM (key derived from ADMIN_SESSION_SECRET).
#
# Precedence: this env var wins. Leave it blank to use the key stored
# through the admin UI — that is the intended build-phase workflow.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://amatessolutions.com
OPENROUTER_SITE_NAME=Amates Solutions

# Admin backoffice passkey (build phase — see README "Security notes")
ADMIN_PASSKEY=5309
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Machine-to-machine access for POST /api/quote/generate (header: x-api-key)
AGENT_API_KEY=

# WhatsApp Cloud API — webhook verification token (GET handshake).
# Can also be set in the backoffice at /admin/settings. This env var wins.
WHATSAPP_VERIFY_TOKEN=amates-verify

# WhatsApp Cloud API — sending. BACKEND ONLY.
#
# Both can be entered in the backoffice (/admin/settings → WhatsApp sending),
# where the access token is stored in Postgres encrypted with AES-256-GCM.
# Precedence: these env vars win. That is the intended production arrangement;
# the admin fields are for setting it up without a redeploy.
#
# WHATSAPP_PHONE_NUMBER_ID is the *sending* number's ID from
# Meta App Dashboard → WhatsApp → API Setup (the numeric ID, not the number).
# WHATSAPP_ACCESS_TOKEN is a permanent System User token with
# whatsapp_business_messaging — the token Meta shows on that page expires in 24h.
#
# Note: WhatsApp only allows free-form replies inside the 24-hour customer
# service window, so replies work for WhatsApp enquiries and are skipped (and
# logged as skipped) for web-form leads until they message us. Email (below) is
# what reaches those leads.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional. Meta retires Graph API versions on a schedule; check the docs if sends start failing.
WHATSAPP_API_VERSION=v26.0

# Email — BACKEND ONLY. Used by src/lib/email.ts
#
# WhatsApp cannot deliver a free-form reply to a web-form lead, because Meta only
# permits those inside the 24-hour service window. Without email, a web enquiry
# gets no acknowledgement at all; with it, the agent replies by email instead of
# giving up.
#
# Provider is Resend (https://resend.com), called over plain fetch. Resend's free
# tier covers 3,000 emails/month, which is well beyond current volume.
#
# EMAIL_FROM must be a verified sender or domain in Resend, e.g.
# "Amates Solutions <hello@amatessolutions.com>".
# Leave both blank to keep email delivery switched off; outbound is then logged
# as "not delivered" with the reason, never as sent.
EMAIL_API_KEY=
EMAIL_FROM=
# Optional. Point at any Resend-compatible endpoint.
EMAIL_API_URL=

# Optional: field crew dispatch hook fired from the booking calendar
CREW_DISPATCH_WEBHOOK_URL=

# Bearer token for POST /api/cron/sweep (Vercel Cron sends this automatically)
CRON_SECRET=
